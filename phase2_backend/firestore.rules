rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Vartotojų profiliai: kiekvienas mato visus (vardams).
    //
    // ⚠️ EKONOMIKOS SAUGA: klientas gali keisti TIK `username`. Visus pinigų/
    // teisių laukus (coins, playPacks, premiumUntil, adPacksToday, adPacksDate,
    // recentQuestions, unlockedModes) rašo TIK Cloud Functions (Admin SDK
    // taisyklių nepaiso). Kitaip nulaužtas klientas įrašytų sau begalę monetų,
    // nemokamus paketus ar „premium amžinai" ir apeitų visą serverio logiką.
    function validUsername() {
      return request.resource.data.username is string
             && request.resource.data.username.size() >= 2
             && request.resource.data.username.size() <= 16;
    }
    match /users/{userId} {
      allow read: if request.auth != null;

      // Sukurti dokumentą klientas gali TIK su vienu lauku — username
      // (pirmas kartas, kol serveris dar nesukūrė profilio).
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.keys().hasOnly(['username'])
                    && validUsername();

      // Atnaujinti — leidžiama TIK jei keičiamas vienintelis laukas `username`.
      // Bet koks bandymas paliesti coins/playPacks/premiumUntil ir kt. — blokuojama.
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username'])
                    && validUsername();

      allow delete: if false;
    }

    // Globali reitingų lentelė: žaidėjai gali TIK skaityti.
    // Rašo TIK Cloud Functions (Admin SDK taisyklių neriboja).
    match /leaderboard/{scoreId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Aktyvūs žaidimai (su slaptais atsakymais): klientui VISIŠKAI uždara.
    match /active_games/{gameId} {
      allow read, write: if false;
    }
  }
}
